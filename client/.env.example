# Base das chamadas à API. Sem isto o axios manda as requisições para a
# própria origem do Vite e todas voltam 404 — a tela de login responde
# "Não foi possível entrar" sem nada no log do backend.
VITE_API_URL=http://localhost:8000/api

# Token do Mapbox, usado nos mapas de operação e rastreamento.
VITE_MAPBOX_ACCESS_TOKEN=
